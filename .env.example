# Turso Database credentials (libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token

# Session Authentication & HMAC secret
AUTH_SECRET=your-random-32-byte-secret

# Google Gemini API Key for original transformative summaries
GEMINI_API_KEY=your-gemini-api-key
